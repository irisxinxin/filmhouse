# Backend Environment Variables (Railway)
# Copy this to Railway Dashboard → Variables

SERVER_PORT=8080
GIN_MODE=release

# Database (Railway MySQL - use variable references)
# DB_HOST=${{MySQL.MYSQLHOST}}
# DB_PORT=${{MySQL.MYSQLPORT}}
# DB_USER=${{MySQL.MYSQLUSER}}
# DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
# DB_NAME=${{MySQL.MYSQLDATABASE}}

# JWT - CHANGE THIS!
JWT_SECRET=change-this-to-a-secure-random-string

# Stripe Payment
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Email (Resend)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Filmhouse <tickets@yourdomain.com>

# CORS - Add your Vercel domain
CORS_ORIGINS=https://filmhouse.vercel.app

# Set to true for first deployment only
SEED_DATA=false
